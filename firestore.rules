rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Nickname reservation, ensures uniqueness
    match /nicknames/{nickname} {
      allow read: if request.auth != null;

      // Only allow create
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['userId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['userId', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt == request.time
        // Validate nickname format (lowercase alphanumeric + underscore, 1-20 chars)
        && nickname.matches('^[a-z0-9_]+$')
        && nickname.size() >= 1
        && nickname.size() <= 20;

      // Allow owner to delete (for rollback if profile creation fails)
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // User profiles, owner-only access to protect email
    match /users/{userId} {
      allow read: if request.auth != null
        && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['nickname', 'email', 'createdAt'])
        && request.resource.data.keys().hasOnly(['nickname', 'email', 'createdAt'])
        && request.resource.data.nickname is string
        // Validate nickname format (alphanumeric + underscore, 1-20 chars)
        && request.resource.data.nickname.matches('^[a-zA-Z0-9_]+$')
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 20
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 1
        && request.resource.data.createdAt == request.time
        // Verify nickname was claimed by this user
        && exists(/databases/$(database)/documents/nicknames/$(request.resource.data.nickname.lower()))
        && get(/databases/$(database)/documents/nicknames/$(request.resource.data.nickname.lower())).data.userId == request.auth.uid;
        
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['nickname', 'email', 'createdAt'])
        // Prevent changing immutable fields
        && request.resource.data.nickname == resource.data.nickname
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // Chat channels
    match /channels/{channelId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['name', 'createdBy', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'createdBy', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100
        && request.resource.data.createdAt == request.time;

      allow update: if request.auth != null
        && request.auth.uid == resource.data.createdBy
        && request.resource.data.keys().hasOnly(['name', 'createdBy', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100
        // Prevent changing immutable fields
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.createdBy;

      // Messages within a channel
      match /messages/{messageId} {
        allow read: if request.auth != null;

        allow create: if request.auth != null
          && request.resource.data.keys().hasAll(['text', 'userId', 'userNickname', 'createdAt', 'channelId'])
          && request.resource.data.keys().hasOnly(['text', 'userId', 'userNickname', 'createdAt', 'channelId'])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 5000
          && request.resource.data.channelId == channelId
          && request.resource.data.createdAt == request.time
          // Validate nickname matches user's profile to prevent impersonation
          && request.resource.data.userNickname == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.nickname;

        allow update: if request.auth != null
          && request.auth.uid == resource.data.userId
          && request.resource.data.keys().hasOnly(['text', 'userId', 'userNickname', 'createdAt', 'channelId'])
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 5000
          // Prevent changing immutable fields
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.userNickname == resource.data.userNickname
          && request.resource.data.channelId == resource.data.channelId
          && request.resource.data.createdAt == resource.data.createdAt;

        allow delete: if request.auth != null
          && request.auth.uid == resource.data.userId;
      }
    }
  }
}
